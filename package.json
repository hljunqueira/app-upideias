{
  "name": "up-analytics-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "UP Analytics by UpIdeias - Plataforma SaaS de estratégia e métricas para Instagram",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build:web": "npm run build --workspace=apps/web && node scripts/sync-next-output.js",
    "deploy-all": "vercel --prod",
    "deploy:vps": "bash scripts/deploy-vps.sh",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
