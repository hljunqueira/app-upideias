{
  "expo": {
    "name": "UP Analytics",
    "slug": "up-analytics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/UP-Logo-removebg-preview.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/UP-Logo-removebg-preview.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/UP-Logo-removebg-preview.png",
        "backgroundColor": "#050505"
      }
    },
    "web": {
      "favicon": "./assets/UP-Logo-removebg-preview.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
